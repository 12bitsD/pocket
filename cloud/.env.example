# Pocket Cloud self-hosted configuration
POCKET_PORT=8787
POCKET_PUBLIC_URL=https://pocket.example.com

# Initial bootstrap token for first Web login (replace before starting)
POCKET_BOOTSTRAP_KEY=change-me-bootstrap-key

# 32-byte base64 key used to encrypt outbound Agent credentials at rest
POCKET_SECRET_KEY=change-me-32-byte-base64-key

# PostgreSQL connection
POSTGRES_DB=pocket
POSTGRES_USER=pocket
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://pocket:change-me-postgres-password@postgres:5432/pocket
